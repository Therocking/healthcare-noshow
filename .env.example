# ---- Application ----
APP_NAME=healthcare-noshow
ENVIRONMENT=local
LOG_LEVEL=INFO

# ---- PostgreSQL ----
POSTGRES_USER=noshow
POSTGRES_PASSWORD=noshow
POSTGRES_DB=noshow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional: full SQLAlchemy URL. If set, it overrides the POSTGRES_* parts above.
# DATABASE_URL=postgresql+psycopg2://noshow:noshow@localhost:5432/noshow

# ---- Domain ----
# Default analysis year used by the analytics endpoints when ?year= is omitted.
ANALYSIS_DEFAULT_YEAR=2024
# Hard cap enforced by POST /appointments/batch
MAX_BATCH_SIZE=1000
